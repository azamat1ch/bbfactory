{
  "name": "bb-plugin-bbfactory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Requirement-linked tasks, native assignments and content evidence.",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.4.106"
  },
  "bb": {
    "name": "Factory",
    "description": "Requirement-linked tasks, native assignments and content evidence.",
    "branding": {
      "icon": "ListTodo"
    },
    "server": "./src/server.ts",
    "host": "./src/host.ts",
    "app": "./src/app.tsx"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1",
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "12.10.0",
    "@bb/db": "workspace:*"
  }
}
